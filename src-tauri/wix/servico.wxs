<?xml version="1.0" encoding="utf-8"?>
<!--
  Serviço do Windows do Ápice Gestor dentro do .msi (Esteira + Chassi, 09/10/2026).
  COMBINADO com o Chassi (09/10): dois binários no mesmo crate. apice-gestor.exe = cápsula (webview);
  apice-gestor-servico.exe = serviço (sem webview, sem Builder da UI nem single-instance). O serviço
  abre a cápsula em cada sessão com o token do USUÁRIO (nunca SYSTEM) e a reabre se cair; com o
  serviço presente, a casca para de gravar HKCU\Run. Esqueleto TRAVADO até o José Luiz liberar o
  token em ProgramData (DPAPI LocalMachine) + enrolamento elevado.
  Demanda de bloqueio de apps, opção B. Plano: Jarvis/PROJETOS/Apice-Gestor/Esteira/Plano-servico-e-assinatura-2026-10-09.md

  ⚠ DESLIGADO DO BUILD (09/10): o tauri-bundler 2.10.1 empacota sozinho todo [[bin]] do crate do
  Tauri, num componente próprio com GUID aleatório, e o light recusa o mesmo arquivo em dois
  componentes (ICE30). Para ligar de novo: o serviço vira um crate separado no workspace (fora dos
  [[bin]] do crate do Tauri; decisão do Chassi) e o workflow o compila com `cargo build -p`.

  Como entra no build: tauri.conf.json → bundle.windows.wix.fragmentPaths ["wix/servico.wxs"] +
  componentRefs ["ApiceGestorServico"] (o tauri-bundler 2.10.1 já carrega o WixUtilExtension).
  O binário do serviço é compilado pelo workflow (build-msi.yml) antes do `tauri build`.

  Binário separado de propósito: ServiceInstall usa o arquivo-chave do PRÓPRIO componente, e o
  apice-gestor.exe está no componente "Path" do template do Tauri, fora do alcance de um fragmento.

  O que o instalar.ps1 espera (já implementado, feat/pipeline):
    - serviço Name="ApiceGestor", conta LocalSystem, início Automático;
    - o script lê a tabela ServiceInstall do .msi: se este fragmento estiver no pacote, ele confere
      o serviço depois do msiexec; se não estiver, segue o caminho atual (HKCU\Run).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <!-- GUID fixo: nunca trocar (o Windows Installer usa para reconhecer o componente em upgrades). -->
      <Component Id="ApiceGestorServico" Guid="{CF0434A1-A5D2-4C04-AD81-DEFEB6F6BE83}">
        <!-- O light.exe do Tauri roda em target\release\wix\<arch>, então o binário está dois níveis
             acima. (O -dSourceDir do Tauri é o caminho do .exe principal, não uma pasta.) -->
        <File Id="ApiceGestorServicoExe" Source="..\..\apice-gestor-servico.exe" KeyPath="yes" Checksum="yes" />

        <ServiceInstall Id="ApiceGestorServicoInstall"
                        Name="ApiceGestor"
                        DisplayName="Ápice Gestor"
                        Description="Ápice Gestor: tarefas do dia e políticas da Ápice. Parar deixa a máquina sem comunicação no Hub."
                        Type="ownProcess"
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Vital="yes">
          <!-- Reinicia em 1 min nas 3 primeiras quedas; zera em 1 dia. A recuperação para saída com
               erro (failureflag) o instalar.ps1 liga com sc.exe, porque o util:ServiceConfig não cobre. -->
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="60"
                              ResetPeriodInDays="1" />
        </ServiceInstall>

        <!-- Sobe na instalação; para antes de trocar arquivos (instalar/atualizar/remover); some na
             desinstalação. Wait="yes": o msiexec só termina quando o serviço respondeu. -->
        <ServiceControl Id="ApiceGestorServicoControl"
                        Name="ApiceGestor"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
